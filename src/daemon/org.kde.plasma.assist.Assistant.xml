<node>
  <interface name="org.kde.plasma.assist.Assistant">
    <!-- JSON object: version, ready, actionsAllowed, languageModel (status, error, name, model), troubleshooter (status, error, tools) -->
    <method name="Status">
      <arg type="s" direction="out"/>
    </method>
    <!-- Returns identifier of the new conversation -->
    <method name="NewConversation">
      <arg type="s" direction="out"/>
    </method>
    <!-- JSON array of conversations: id, title, dateTime -->
    <method name="ListConversations">
      <arg type="s" direction="out"/>
    </method>
    <!-- JSON array of messages: id, role (user, assistant), text, dateTime, inProgress, toolCalls (id, name, arguments, result) -->
    <method name="GetMessages">
      <arg name="conversation" type="s" direction="in"/>
      <arg type="s" direction="out"/>
    </method>
    <!-- Sends message to language model, which can call tools. Answer is sent with MessageChunk and MessageFinished,
         or ConversationError -->
    <method name="SendMessage">
      <arg name="conversation" type="s" direction="in"/>
      <arg name="text" type="s" direction="in"/>
    </method>
    <!-- Stops answer in progress -->
    <method name="Cancel">
      <arg name="conversation" type="s" direction="in"/>
    </method>
    <!-- JSON array: tools of troubleshooter server (MCP tools/list) -->
    <method name="ListTools">
      <arg type="s" direction="out"/>
    </method>
    <!-- Calls tool without language model (quick diagnostic): only tools which don't change system. argumentsJson: JSON object.
         Returns MCP tool result (JSON): content, structuredContent, isError -->
    <method name="CallTool">
      <arg name="name" type="s" direction="in"/>
      <arg name="argumentsJson" type="s" direction="in"/>
      <arg type="s" direction="out"/>
    </method>
    <!-- Answer to ConfirmationRequested: 0 = Deny, 1 = Allow, 2 = Always allow this tool (never for destructive tools).
         Only client which sent message can answer. Returns false when request is unknown -->
    <method name="Confirm">
      <arg name="requestId" type="s" direction="in"/>
      <arg name="answer" type="i" direction="in"/>
      <arg type="b" direction="out"/>
    </method>
    <!-- Actions (tools which change system) are disabled by default -->
    <method name="SetActionsAllowed">
      <arg name="allowed" type="b" direction="in"/>
    </method>
    <!-- JSON array of changes made by assistant (most recent first): id, dateTime, tool, summary, undoable, undone -->
    <method name="ListChanges">
      <arg type="s" direction="out"/>
    </method>
    <!-- Restores state before change: refused when system has changed since. Returns MCP tool result (JSON) -->
    <method name="UndoChange">
      <arg name="changeId" type="s" direction="in"/>
      <arg type="s" direction="out"/>
    </method>
    <!-- JSON array of guided scenarios (prompts of server): name, title, description, icon, diagnosticTools -->
    <method name="ListScenarios">
      <arg type="s" direction="out"/>
    </method>
    <!-- Sends scenario to language model in conversation. details: description of user (can be empty).
         Answer is sent like SendMessage -->
    <method name="StartScenario">
      <arg name="conversation" type="s" direction="in"/>
      <arg name="scenario" type="s" direction="in"/>
      <arg name="details" type="s" direction="in"/>
    </method>
    <!-- Runs diagnostic tools of scenario without language model. Returns summaries (Markdown list) -->
    <method name="QuickDiagnostic">
      <arg name="scenario" type="s" direction="in"/>
      <arg type="s" direction="out"/>
    </method>
    <signal name="StatusChanged">
      <arg name="status" type="s" direction="out"/>
    </signal>
    <signal name="ConversationsChanged"/>
    <!-- text: whole answer received so far -->
    <signal name="MessageChunk">
      <arg name="conversation" type="s" direction="out"/>
      <arg name="messageId" type="s" direction="out"/>
      <arg name="text" type="s" direction="out"/>
    </signal>
    <signal name="MessageFinished">
      <arg name="conversation" type="s" direction="out"/>
      <arg name="messageId" type="s" direction="out"/>
    </signal>
    <signal name="ToolCallStarted">
      <arg name="conversation" type="s" direction="out"/>
      <arg name="callId" type="s" direction="out"/>
      <arg name="tool" type="s" direction="out"/>
      <arg name="argumentsJson" type="s" direction="out"/>
    </signal>
    <signal name="ToolCallFinished">
      <arg name="conversation" type="s" direction="out"/>
      <arg name="callId" type="s" direction="out"/>
      <arg name="result" type="s" direction="out"/>
      <arg name="isError" type="b" direction="out"/>
    </signal>
    <!-- Assistant needs a confirmation before changing system. risk: modify or destructive.
         Request is denied after 120 seconds -->
    <signal name="ConfirmationRequested">
      <arg name="requestId" type="s" direction="out"/>
      <arg name="conversation" type="s" direction="out"/>
      <arg name="tool" type="s" direction="out"/>
      <arg name="summary" type="s" direction="out"/>
      <arg name="argumentsJson" type="s" direction="out"/>
      <arg name="risk" type="s" direction="out"/>
    </signal>
    <signal name="ConfirmationFinished">
      <arg name="requestId" type="s" direction="out"/>
      <arg name="allowed" type="b" direction="out"/>
    </signal>
    <signal name="ChangesChanged"/>
    <!-- Information shown in conversation (e.g. an action was refused because actions are disabled) -->
    <signal name="ConversationNotice">
      <arg name="conversation" type="s" direction="out"/>
      <arg name="text" type="s" direction="out"/>
    </signal>
    <signal name="ConversationError">
      <arg name="conversation" type="s" direction="out"/>
      <arg name="error" type="s" direction="out"/>
    </signal>
  </interface>
</node>
