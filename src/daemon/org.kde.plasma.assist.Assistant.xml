<node>
  <interface name="org.kde.plasma.assist.Assistant">
    <!-- JSON object: version, ready, conversations, troubleshooter (status, error, tools) -->
    <method name="Status">
      <arg type="s" direction="out"/>
    </method>
    <!-- Returns identifier of the new conversation -->
    <method name="NewConversation">
      <arg type="s" direction="out"/>
    </method>
    <!-- JSON array: tools of troubleshooter server (MCP tools/list) -->
    <method name="ListTools">
      <arg type="s" direction="out"/>
    </method>
    <!-- Calls tool without language model (quick diagnostic). argumentsJson: JSON object.
         Returns MCP tool result (JSON): content, structuredContent, isError -->
    <method name="CallTool">
      <arg name="name" type="s" direction="in"/>
      <arg name="argumentsJson" type="s" direction="in"/>
      <arg type="s" direction="out"/>
    </method>
    <signal name="StatusChanged">
      <arg name="status" type="s" direction="out"/>
    </signal>
  </interface>
</node>
